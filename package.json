{
  "name": "second-nature-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "SITE_BASE=${SITE_BASE:-/} vite build && SITE_BASE=${SITE_BASE:-/} vite build --ssr src/entry-server.jsx --outDir dist/server && SITE_BASE=${SITE_BASE:-/} node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "build:subpath": "SITE_BASE=/second-nature-website/ npm run build",
    "test": "vitest run",
    "check": "npm run test && npm run build && node scripts/check-dist.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
