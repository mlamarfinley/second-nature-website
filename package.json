{
  "name": "second-nature-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "SITE_BASE=${SITE_BASE:-/} vite build && SITE_BASE=${SITE_BASE:-/} vite build --ssr src/entry-server.jsx --outDir dist/server && SITE_BASE=${SITE_BASE:-/} node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:subpath": "SITE_BASE=/second-nature-website/ npm run build"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
